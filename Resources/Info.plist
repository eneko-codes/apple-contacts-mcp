<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CFBundleName is the label macOS shows in System Settings > Privacy & Security >
	     Contacts. Keep it identical to the binary name so the toggle is recognisable. -->
	<key>CFBundleName</key>
	<string>apple-contacts-mcp</string>
	<key>CFBundleIdentifier</key>
	<string>codes.eneko.apple-contacts-mcp</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>10</string>

	<!-- The exact key tccd looks for; verified against the tccd binary on macOS 26.5.
	     Shown verbatim in the consent dialog, so it is written for the person reading it. -->
	<key>NSContactsUsageDescription</key>
	<string>Lets Claude search, read and edit your contacts through this local MCP server.</string>

	<!-- Governs the note field and nothing else. Contacts.framework refuses
	     CNContactNoteKey without com.apple.developer.contacts.notes, a managed capability
	     that has to be authorised by a provisioning profile a command-line binary cannot
	     carry, so notes come from Contacts.app over Apple events instead. Without this
	     string tccd denies the automation outright and never shows a dialog. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Lets Claude read and write the Notes field of your contacts, which macOS only exposes through the Contacts app.</string>
</dict>
</plist>
